# Project PHPStan configuration. It replaces php-qa-ci's configDefaults/generic/phpstan.neon, so the
# two settings that file carries are repeated here, followed by this project's own defences. The
# rules are documented in docs/defence-before-fix.md and indexed in docs/phpstan-rules/README.md.
parameters:
    level: max
    inferPrivatePropertyTypeFromConstructor: true
    excludePaths:
        # Fixtures of the defences' own tests: each one is deliberately an instance of the bug class.
        analyseAndScan:
            - ../tests/Fixtures/Defence/*

rules:
    # Bundled with php-qa-ci but opt-in: a catch block that neither uses, logs nor rethrows the exception.
    - LTS\PHPQA\PHPStan\Rules\ForbidSilentCatchRule
    # Bundled with php-qa-ci but opt-in: a scalar documented as a closed set of literals ('a'|'b').
    - LTS\PHPQA\PHPStan\Rules\RequireEnumOverLiteralUnionRule
    - QaConfig\PHPStan\Rules\RecursionThroughNativeCallbackRule
    - QaConfig\PHPStan\Rules\UnguardedAliasRecursionRule
    - QaConfig\PHPStan\Rules\LoopInvariantConstructionRule

services:
    # Bundled with php-qa-ci but opt-in: a string literal written three or more times in one class. Production
    # code only: test data repeats literals on purpose, one assertion per value (docs/phpstan-rules/README.md).
    -
        class: QaConfig\PHPStan\Rules\ProductionOnlyRule
        arguments:
            inner: LTS\PHPQA\PHPStan\Rules\ForbidRepeatedStringLiteralRule()
            excludedDirectory: %currentWorkingDirectory%/tests
        tags:
            - phpstan.rules.rule
