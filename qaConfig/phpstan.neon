# Project PHPStan configuration. It replaces php-qa-ci's configDefaults/generic/phpstan.neon, so the
# two settings that file carries are repeated here, followed by this project's own defences. The
# rules are documented in docs/defence-before-fix.md and indexed in docs/phpstan-rules/README.md.
parameters:
    level: max
    inferPrivatePropertyTypeFromConstructor: true
    excludePaths:
        # Fixtures of the defences' own tests: each one is deliberately an instance of the bug class.
        analyseAndScan:
            - ../tests/Fixtures/Defence/*

rules:
    # Bundled with php-qa-ci but opt-in: a catch block that neither uses, logs nor rethrows the exception.
    - LTS\PHPQA\PHPStan\Rules\ForbidSilentCatchRule
    # Bundled with php-qa-ci but opt-in: a scalar documented as a closed set of literals ('a'|'b').
    - LTS\PHPQA\PHPStan\Rules\RequireEnumOverLiteralUnionRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNullCoalescingEmptyStringRule
    - LTS\PHPQA\PHPStan\Rules\ForbidNullCoalescingFalseRule
    - LTS\PHPQA\PHPStan\Rules\RequireReadonlyServiceRule
    - LTS\PHPQA\PHPStan\Rules\RequireConsistentMemberDocsRule
    - LTS\PHPQA\PHPStan\Rules\RequireVariadicOverArrayParameterRule
    - LTS\PHPQA\PHPStan\Rules\ForbidAmbiguousArrayDocRule
    - LTS\PHPQA\PHPStan\Rules\ForbidInsecureFunctionsRule
    - LTS\PHPQA\PHPStan\Rules\ForbidDebugOutputFunctionsRule
    - QaConfig\PHPStan\Rules\RecursionThroughNativeCallbackRule
    - QaConfig\PHPStan\Rules\UnguardedAliasRecursionRule
    - QaConfig\PHPStan\Rules\LoopInvariantConstructionRule

services:
    # Bundled with php-qa-ci but opt-in: a string literal written three or more times in one class. Production
    # code only: test data repeats literals on purpose, one assertion per value (docs/phpstan-rules/README.md).
    -
        class: QaConfig\PHPStan\Rules\ProductionOnlyRule
        arguments:
            inner: LTS\PHPQA\PHPStan\Rules\ForbidRepeatedStringLiteralRule()
            excludedDirectory: %currentWorkingDirectory%/tests
        tags:
            - phpstan.rules.rule
    # A closed set of names written as strings. Production code only. The syntax namespaces are the one allowed
    # exception: their literals are the grammar of an external text syntax (reasons in
    # docs/phpstan-rules/string-discriminator.md).
    -
        class: QaConfig\PHPStan\Rules\ProductionOnlyRule
        arguments:
            inner: QaConfig\PHPStan\Rules\StringDiscriminatorRule([
                LTS\PhpXq\Json,
                LTS\PhpXq\Yaml\Token,
                LTS\PhpXq\Yaml\Parser,
                LTS\PhpXq\Yaml\Schema,
                LTS\PhpXq\Jq\Parser,
                LTS\PhpXq\Yq\Expression\Parser,
                LTS\PhpXq\Jq\Builtin\Regex,
                LTS\PhpXq\Jq\Builtin\Date\Strftime,
                LTS\PhpXq\Jq\Builtin\Date\Strptime,
                LTS\PhpXq\Yq\Format\Codec\HclReader,
                LTS\PhpXq\Yq\Format\Codec\JsonReader,
                LTS\PhpXq\Yq\Format\Codec\LuaReader,
                LTS\PhpXq\Yq\Format\Codec\PropsDecoder,
                LTS\PhpXq\Yq\Format\Codec\TomlParser,
                LTS\PhpXq\Yq\Format\Codec\XmlReader,
                LTS\PhpXq\Yq\Runtime\GoTime,
                LTS\PhpXq\Yq\Runtime\GoRegex,
                LTS\PhpXq\Yq\Runtime\Numbers,
            ])
            excludedDirectory: %currentWorkingDirectory%/tests
        tags:
            - phpstan.rules.rule
