# Pinned build tooling, sourced by scripts/build-phar.bash and scripts/build-binary.bash.
# Every download is verified against the SHA-256 recorded here; bump a version and its checksum together.

# Box (PHAR builder): https://github.com/box-project/box/releases
BOX_VERSION=4.7.0
BOX_SHA256=3d390eeaec33288098fe83f8a54c60cc575cb6be295f38ff4482b4b4f26f8d52

# static-php-cli (spc, builds the micro SFX runtime): https://github.com/crazywhalecc/static-php-cli/releases
SPC_VERSION=2.8.5
SPC_SHA256_linux_x86_64=523ba4279c54c7a377156c0dd3a36adf92ee64b01e9a7f5e9e2ec084b8e458e5
SPC_SHA256_linux_aarch64=675a3840dcdc4ed041fe20eaa54310ce019a9984c1c03951df9ec66df5795213
SPC_SHA256_macos_x86_64=e8b798048f62ca4960764196543b60ae703f7174aa418824cf542aeec1d2cd6a
SPC_SHA256_macos_aarch64=acf2f25d56d0cbf8e65aa82e5054fef555f7be7c5c38046c6e0819f266d83225

# PHP major.minor compiled into the static runtime (must satisfy composer.json "php").
SPC_PHP_VERSION=8.5
