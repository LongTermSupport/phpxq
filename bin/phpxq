#!/usr/bin/env php
<?php

declare(strict_types=1);

use LTS\PhpXq\Cli\EntryPoint;
use LTS\PhpXq\Cli\FrontController;

// The production code has no Composer dependencies, so a PSR-4 closure for the one namespace replaces
// vendor/autoload.php: Composer's loader, class map and platform check cost about 1.5 ms of CPU on every start
// (bench `jq:startup`, CLAUDE/Plan/00007-performance-optimisation-round/results.md).
spl_autoload_register(static function (string $class): void {
    if (str_starts_with($class, 'LTS\\PhpXq\\')) {
        $file = __DIR__ . '/../src/' . strtr(substr($class, 10), '\\', '/') . '.php';
        if (is_file($file)) {
            require $file;
        }
    }
});

/** @var list<string> $argv */
exit(new EntryPoint(new FrontController(), \dirname(__DIR__) . '/VERSION')
    ->run($argv[0], \array_slice($argv, 1), STDIN, STDOUT, STDERR));
