{
    "name": "lts/php-xq",
    "description": "Pure PHP command-line equivalents of jq and yq",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "lts/php-qa-ci": "^85.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "LTS\\PhpXq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LTS\\PhpXq\\Tests\\": "tests/",
            "QaConfig\\": [
                "qaConfig/"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "lts/php-qa-ci": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
